name: Publish and deploy to AWS EC2
on:
  workflow_dispatch:
  push:
    branches: [main]
permissions:
  contents: read
  packages: write
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip
      - run: pip install -r requirements-dev.txt
      - run: python -m pytest -q tests/
  publish:
    needs: test
    runs-on: ubuntu-latest
    outputs:
      image: ${{ steps.name.outputs.image }}
    steps:
      - uses: actions/checkout@v4
      - name: Set lowercase container image name
        id: name
        shell: bash
        run: |
          IMAGE="ghcr.io/$(echo "$GITHUB_REPOSITORY" | tr '[:upper:]' '[:lower:]')"
          echo "image=$IMAGE" >> "$GITHUB_OUTPUT"
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: |
            ${{ steps.name.outputs.image }}:${{ github.sha }}
            ${{ steps.name.outputs.image }}:latest
  deploy:
    needs: publish
    runs-on: ubuntu-latest
    steps:
      - name: Deploy exact commit image over SSH
        shell: bash
        env:
          EC2_HOST: ${{ secrets.EC2_HOST }}
          EC2_SSH_KEY: ${{ secrets.EC2_SSH_KEY }}
          EC2_KNOWN_HOSTS: ${{ secrets.EC2_KNOWN_HOSTS }}
          IMAGE: ${{ needs.publish.outputs.image }}
          SHA: ${{ github.sha }}
        run: |
          set -euo pipefail
          test -n "$EC2_HOST" && test -n "$EC2_SSH_KEY" && test -n "$EC2_KNOWN_HOSTS"
          mkdir -p ~/.ssh
          chmod 700 ~/.ssh
          printf '%s\n' "$EC2_SSH_KEY" > ~/.ssh/ec2_key
          printf '%s\n' "$EC2_KNOWN_HOSTS" > ~/.ssh/known_hosts
          chmod 600 ~/.ssh/ec2_key ~/.ssh/known_hosts
          ssh -o StrictHostKeyChecking=yes -i ~/.ssh/ec2_key "ec2-user@${EC2_HOST}" \
            "IMAGE='${IMAGE}' SHA='${SHA}' bash -se" <<'REMOTE'
          set -euo pipefail
          docker pull "${IMAGE}:${SHA}"
          docker rm -f shedding-outlook 2>/dev/null || true
          docker run -d --name shedding-outlook --restart unless-stopped \
            -p 80:8000 --memory 2g "${IMAGE}:${SHA}"
          sleep 3
          curl -fsS http://localhost/health
          REMOTE
